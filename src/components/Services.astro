---
import { services } from "../data/services";
---

<section id="services" class="services">
  <div class="container">
    <div class="section-head">
      <h2>Build it and run it — one capability</h2>
      <p class="prose-measure">
        Software development and DevOps aren't two separate menu items here. They're one pipeline,
        handled by the two people who built it.
      </p>
    </div>

    <ol class="pipeline">
      {
        services.map((service, index) => (
          <li class="pipeline-row" data-accent={service.id}>
            <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="row-main">
              <p class="label">{service.label}</p>
              <h3>{service.title}</h3>
              <p class="prose-measure description">{service.description}</p>
              <ul class="details">
                {service.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 44rem;
    margin-bottom: var(--space-2xl);
  }

  .section-head h2 {
    font-size: var(--text-headline);
    letter-spacing: -0.015em;
  }

  .section-head p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .pipeline-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .pipeline-row + .pipeline-row {
    border-top: 1px solid var(--color-border);
  }

  .row-index {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    color: oklch(0.5 0.012 38);
  }

  .row-main h3 {
    font-size: var(--text-title);
    margin-top: var(--space-2xs);
  }

  [data-accent="build"] .label,
  [data-accent="build"] h3 {
    color: var(--color-mango);
  }

  [data-accent="run"] .label,
  [data-accent="run"] h3 {
    color: var(--color-leaf);
  }

  .description {
    margin-top: var(--space-sm);
    color: var(--color-ink);
    opacity: 0.85;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .details li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .pipeline-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .row-index {
      font-size: 1.5rem;
    }
  }
</style>
