---
import { nav, site } from "../data/site";
---

<header class="site-header">
  <div class="container bar">
    <a href="#top" class="wordmark">
      Mango<span class="byte">Byte</span>
    </a>
    <nav aria-label="Section navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
  const sections = links
    .map((link) => document.querySelector(link.getAttribute("href") || ""))
    .filter((el): el is Element => el !== null);

  if ("IntersectionObserver" in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = `#${entry.target.id}`;
          links.forEach((link) => {
            const isActive = link.getAttribute("href") === id;
            link.toggleAttribute("aria-current", isActive);
            if (isActive) link.setAttribute("aria-current", "true");
          });
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in oklch, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    min-height: var(--header-height);
    padding-block: var(--space-2xs);
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .byte {
    color: var(--color-mango);
  }

  nav ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) ease-out, border-color var(--duration-fast) ease-out;
  }

  @media (hover: hover) {
    nav a:hover {
      color: var(--color-ink);
    }
  }

  nav a:active {
    color: var(--color-ink);
  }

  nav a[aria-current="true"] {
    color: var(--color-leaf);
    border-color: var(--color-leaf);
  }

  /* Below the width where the wordmark + inline nav fit together, the nav drops
     to its own full-width row so every link stays visible — no hidden menu, no
     clipped "Contact". */
  @media (max-width: 34rem) {
    .bar {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0;
      padding-block: var(--space-2xs);
    }

    .wordmark {
      flex: 1 0 100%;
      text-align: center;
      padding-top: var(--space-2xs);
    }

    nav {
      flex: 1 0 100%;
    }

    nav ul {
      justify-content: space-between;
      gap: var(--space-xs);
    }

    nav a {
      min-height: 40px;
    }
  }

  @media (max-width: 22rem) {
    nav ul {
      gap: var(--space-2xs);
    }

    nav a {
      font-size: var(--text-label);
    }
  }
</style>
