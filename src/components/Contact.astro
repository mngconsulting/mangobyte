---
import { founders } from "../data/founders";
import { site } from "../data/site";
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-copy">
        <h2>Say hello</h2>
        <p class="prose-measure">
          No forms, no funnels — just tell us what you're building or what's breaking.
          We usually reply within a day.
        </p>
        <div class="mail-actions">
          <a class="mail-cta" href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          <button type="button" class="copy-btn" data-copy={site.contactEmail}>
            <span class="copy-label">Copy</span>
          </button>
        </div>
      </div>
      <ul class="direct-emails" aria-label="Direct contact for each founder">
        {
          founders.map((founder) => (
            <li>
              <span class="label">{founder.name}</span>
              <a href={`mailto:${founder.email}`}>{founder.email}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".copy-btn");
  const label = btn?.querySelector<HTMLElement>(".copy-label");

  if (btn && label && navigator.clipboard) {
    let resetTimer: number | undefined;
    btn.addEventListener("click", async () => {
      const email = btn.dataset.copy;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = "Copied";
        btn.classList.add("is-copied");
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          label.textContent = "Copy";
          btn.classList.remove("is-copied");
        }, 2000);
      } catch {
        label.textContent = "Press ⌘C";
      }
    });
  } else if (btn) {
    // No async clipboard available — the mailto link still works, so hide the button.
    btn.hidden = true;
  }
</script>

<style>
  .contact {
    padding-block: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .contact-copy h2 {
    font-size: var(--text-headline);
    letter-spacing: -0.015em;
  }

  .contact-copy p {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .mail-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .mail-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-sm);
    background: var(--mango-fill);
    color: var(--on-mango);
    font-weight: 600;
    text-decoration: none;
    word-break: break-word;
    transition: box-shadow var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo), background var(--duration-fast) ease-out;
  }

  @media (hover: hover) {
    .mail-cta:hover {
      box-shadow: var(--shadow-cta-hover);
      transform: translateY(-1px);
      background: var(--mango-fill-hover);
    }
  }

  .mail-cta:active {
    transform: translateY(0);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    cursor: pointer;
    transition: color var(--duration-fast) ease-out, border-color var(--duration-fast) ease-out;
  }

  @media (hover: hover) {
    .copy-btn:hover {
      color: var(--color-ink);
      border-color: var(--color-muted);
    }
  }

  .copy-btn.is-copied {
    color: var(--color-leaf);
    border-color: color-mix(in oklch, var(--color-leaf) 40%, var(--color-border));
  }

  .direct-emails {
    list-style: none;
    margin: 0;
    padding: var(--space-lg);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .direct-emails li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .direct-emails .label {
    color: var(--color-muted);
  }

  .direct-emails a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-leaf);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in oklch, var(--color-leaf) 45%, transparent);
    word-break: break-word;
    transition: text-decoration-color var(--duration-fast) ease-out;
  }

  @media (hover: hover) {
    .direct-emails a:hover {
      text-decoration-color: var(--color-leaf);
    }
  }

  @media (max-width: 40rem) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
